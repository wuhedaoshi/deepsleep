# 统一换行与文本判定：跨 Windows / Linux 协作时别让 CRLF 混进 diff
* text=auto eol=lf

# Windows 上必须保持 CRLF 的脚本
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Shell 脚本必须 LF，否则容器里跑不起来
*.sh    text eol=lf

# 二进制：不要当文本 diff
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.ico   binary
*.jar   binary
*.apk   binary
*.zip   binary
*.woff  binary
*.woff2 binary
*.ttf   binary

# 构建产物与归属文件
pnpm-lock.yaml  -diff linguist-generated
gradlew         text eol=lf
gradlew.bat     text eol=crlf
